# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ISSUER=go-better-auth
JWT_AUDIENCE=go-better-auth
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h
JWT_CLOCK_SKEW=5m

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-at-least-32-characters-long
SESSION_EXPIRATION=24h
SESSION_COOKIE_NAME=session
SESSION_SECURE=true
SESSION_HTTP_ONLY=true

# Password Configuration
PASSWORD_ALGORITHM=bcrypt
PASSWORD_BCRYPT_COST=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=false

# Database Configuration
DATABASE_DRIVER=sqlite
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=auth.db
DATABASE_USER=
DATABASE_PASSWORD=
# Defaults to "require". Use "disable" only for local development.
DATABASE_SSL_MODE=require
DATABASE_MAX_CONNS=10
DATABASE_IDLE_TIMEOUT=30m

# Redis Configuration (Optional)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_DIAL_TIMEOUT=5s

# Email Configuration
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASS=your-email-password
EMAIL_FROM_ADDRESS=your-email@gmail.com
EMAIL_FROM_NAME=Go Better Auth

# Security Configuration
# Optional: reserved, no consumer yet.
ENCRYPTION_KEY=your-super-secret-encryption-key-at-least-32-characters-long
# Comma-separated allowlist. Empty by default; "*" allows any origin and should not
# be used in production.
CORS_ALLOWED_ORIGINS=
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true

# OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_TLS=false

# Feature Flags
FEATURE_REGISTRATION=true
FEATURE_PASSWORD_RESET=true
FEATURE_EMAIL_VERIFICATION=true
FEATURE_TWO_FACTOR_AUTH=false
